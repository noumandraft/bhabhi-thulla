# Frontend: public URL of the Render server (set before `npm run build:client`)
VITE_SERVER_URL=http://localhost:3001
# Optional public revision label used in diagnostics and service-worker versioning.
VITE_APP_COMMIT=local

# Server: allowed frontend origin(s), comma separated. Do not use * in production.
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
# Party Mode backend capability is deployed fail-closed. Use beta for a hidden
# preview or public only when the separate Party board/controller UI is ready.
PARTY_MODE=off

# Optional shared room store. Leave REDIS_URL empty to use process memory locally.
REDIS_URL=
REDIS_KEY_PREFIX=bhabhi-thulla:room:
# Set true only when the Redis-compatible provider guarantees persistence.
REDIS_DURABLE=false

# Optional server revision outside Render. Render supplies RENDER_GIT_COMMIT itself.
COMMIT_SHA=local
# RENDER_GIT_COMMIT=
